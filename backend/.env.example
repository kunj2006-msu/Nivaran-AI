# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key (Used for embeddings generation: gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Used for LLM text generation: qwen/qwen3.6-27b)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=NivaranAiSupportBot

# Admin API Security Key (Optional, set for protected admin routes)
ADMIN_API_KEY=your_admin_secret_key_here

# Telegram Mode: "polling" or "webhook"
TELEGRAM_MODE=polling
WEBHOOK_URL=

# Supabase Credentials & Database URL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres

# SMTP Email Configuration (Gmail / Mailtrap / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
SENDER_EMAIL=ShopNest Support <your_email@gmail.com>
